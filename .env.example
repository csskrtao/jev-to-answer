# 复制为 .env 用于 npm start；复制为 .dev.vars 用于 npm run cf:dev。
# 线上密钥使用 wrangler secret put，不要写入 wrangler.jsonc。
LLM_BASE_URL=https://your-provider.example/v1
LLM_MODEL=your-model-name
LLM_API_KEY=
JEV_PROVIDER=typesafe
JEV_API_KEY=
# 可选：切换到 vercel 时，不填写以下两项即可使用该通道默认值。
# JEV_BASE_URL=https://api.typesafe.ai/v1
# JEV_MODEL=jev-latest
REQUESTS_PER_MINUTE=12
REQUESTS_PER_DAY=60
GLOBAL_REQUESTS_PER_DAY=3000
